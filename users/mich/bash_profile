#!/bin/bash
# basic login script -*- shell-script -*-

# home-manager's generated env (GNUPGHOME, XDG dirs, locale archive) —
# sourced first so the settings in this file and .bash_env win.
[ -f /etc/profiles/per-user/${USER}/etc/profile.d/hm-session-vars.sh ] && \. /etc/profiles/per-user/${USER}/etc/profile.d/hm-session-vars.sh

[ -f ${HOME}/.bash_env ] && \. ${HOME}/.bash_env
[ -f ${HOME}/.bashrc ] && \. ${HOME}/.bashrc

# delete unwanted files
rm -f ~/.shosts ~/.rhosts ~/.bash_history ~/.lesshst

[ "$TERM" = "xterm" ] && title $LOGNAME@$HOSTNAME

[ -z "$TMUX" ] && type tmux >/dev/null 2>&1 && tmux list-sessions 2>/dev/null | sed 's/^/# tmux /'

