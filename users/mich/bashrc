#!/bin/bash

# If not running interactively, don't do anything
[ -z "$PS1" ] && return
[ ! -t 1 ] && return

[ -z "$MICHEL" ] && \. ${HOME}/.bash_env

[ -f /etc/static/bashrc ] && source /etc/static/bashrc

# FUNCTIONS
#########################################################################

brname () {
  a=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
  if [ -n "$a" ]; then
    echo " [$a]"
  else
    echo ""
  fi
}

title () { echo -n "]0;$*"; }
set -b

# PROMPT
#############################################################################
# export PS1="\$LOGNAME@\$HOSTNAME:\$PWD [\!] \$\\n:; "
export PS1="\$LOGNAME@\h:\$PWD [\!] \$\\n:; "
# use :; to copy-paste entire line and still execute the command
export PS2='(more) :; '

# let control+w only delete one directory of a path, not the whole word
export WORDCHARS='*?_[]~=&;!#$%^(){}'

# TERMINAL INTEGRATION
#############################################################################
# OSC 133 prompt mark + OSC 7 working-directory report before every prompt:
# enables jump-to-prompt (terminal and tmux copy-mode [ / ]) and makes new
# windows/splits open in the current directory.
osc_prompt () { printf '\033]133;A\033\\\033]7;file://%s%s\033\\' "${HOSTNAME}" "${PWD}"; }
PROMPT_COMMAND="osc_prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND}"

# less
##############################################################################
export LESS='inFMQRWX'
export LESSHISTFILE='-'
export LESSCHARSET='utf-8'
type lesspipe >/dev/null 2>&1 && eval `lesspipe`
type lesspipe.sh >/dev/null 2>&1 && eval `lesspipe.sh`

# colors in man pages: less swaps these in for the bold/standout/underline
# it renders from overstrike text. Literal ANSI escapes (valid on every
# terminal we use) rather than tput, to avoid a fork per capability.
export LESS_TERMCAP_md=$'\e[1;36m'    # bold: cyan (headings, names)
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_so=$'\e[1;33;44m' # standout: yellow on blue (status bar)
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_us=$'\e[4;1;37m'  # underline: bold white (literals, args)
export LESS_TERMCAP_ue=$'\e[0m'

# ALIASES
#############################################################################
alias dot='. ~/.bash_profile; echo "# reloaded .bash_profile"'

alias ga='git add'
alias gc='git commit'
alias gco='git checkout'
alias gcp='git cherry-pick'
alias gdiff='git diff'
alias gl='git prettylog'
alias gp='git push'
alias gs='git status'
alias gt='git tag'

alias tf=terraform
alias tl='tmux list-sessions'
alias ta='tmux attach'
alias zed='zeditor'

alias g=egrep
alias h=history
alias j=jobs
alias k=kubectl
alias ks='kubectl run -it --image bash --restart Never --rm shell'
alias man='man -a'
alias cp='cp -i'
alias mv='mv -i'
type gtimeout >/dev/null 2>&1 && alias timeout=gtimeout

# OSC escapes to the local terminal: clipboard copy and desktop
# notifications that work from any ssh/tmux depth. macOS has a native
# pbcopy; only stand in for it where none exists.
type pbcopy >/dev/null 2>&1 || alias pbcopy='osc52.sh'
alias alert='osc777.sh'

# ls
#############################################################################
LS_OPT=''
if [ -t 1 ]; then
  COLORS=$(tput colors 2>/dev/null)
  [ $? -ne 0 ] && COLORS=0
  [ $COLORS -gt 0 ] && [ x$OS = "xfreebsd" ] && LS_OPT='-G'
  [ $COLORS -gt 0 ] && [ x$OS = "xdarwin" ] && LS_OPT='-G'
  [ $COLORS -gt 0 ] && [ x$OS = "xlinux" ] && LS_OPT='--color=auto'
  [ -x /usr/bin/dircolors ] && eval `dircolors ~/.dircolors`
  alias ls="ls -F $LS_OPT"
  alias v='ls -l'
  alias va='ls -al'
  alias vr='ls -lrt'
  alias vz='ls -lSr'
  alias d='ls -s'
  alias da='ls -As'
fi

case $OS in
linux)
;;
darwin)
  alias top="/usr/bin/top -o cpu"
  alias vlc=/Applications/VLC.app/Contents/MacOS/VLC
;;
esac

alias llm='claude --permission-mode auto'

# load direnv
type direnv >/dev/null 2>&1 && eval "$(direnv hook bash)"

# load fzf
# back fzf with ripgrep so file search respects .gitignore, when available
type rg >/dev/null 2>&1 && export FZF_DEFAULT_COMMAND="rg --files --hidden --glob '!.git'" FZF_CTRL_T_COMMAND="rg --files --hidden --glob '!.git'"
type fzf >/dev/null 2>&1 && eval "$(fzf --bash)"

# Use bash-completion, if available
[ -f ${HOME}/.bash_completion ] && \
    . ${HOME}/.bash_completion


