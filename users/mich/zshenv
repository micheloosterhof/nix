#!/bin/zsh

# Commands are then read from $ZDOTDIR/.zshenv. If the shell is a
# login shell, commands are read from /etc/zprofile and then
# $ZDOTDIR/.zprofile. Then, if the shell is interactive, commands are
# read from /etc/zshrc and then $ZDOTDIR/.zshrc. Finally, if the shell
# is a login shell, /etc/zlogin and $ZDOTDIR/.zlogin are read.

umask 077
ulimit -c 0

# This is an attempt to create order from chaos in platform naming:
# $OSTYPE with the version stripped, e.g. darwin, linux, freebsd.
export OS=${OSTYPE%%[-0-9.]*}
#export OSVERSION=`uname -r`; OSVERSION=`expr "$OSVERSION" : '[^0-9]*\([0-9]*\.[0-9]*\)'`
#export MACHINE=`uname -m | sed -e 's/  */-/g;y/ABCDEFGHIJKLMNOPQRSTUVWXYZ/abcdefghijklmnopqrstuvwxyz/'`
#export PLATFORM="$MACHINE-$OS-$OSVERSION"

#[ -z "$HOSTNAME" ] && export HOSTNAME=$(hostname -s)

# Set a basic path that works on most systems
PATHS=( ${HOME}/.bin
        /run/current-system/sw/bin
        /etc/profiles/per-user/${USER}/bin
	/usr/local/sbin
	/usr/local/bin
	/sbin
	/bin
	/usr/sbin
	/usr/bin )

MY_PATH=""
for f in $PATHS; do test -d $f && MY_PATH=$MY_PATH$f:; done
export PATH=${MY_PATH%:}; unset MY_PATH; unset PATHS

# home-manager's generated env (GNUPGHOME, XDG dirs, locale archive) —
# sourced first so the settings below win.
[ -f /etc/profiles/per-user/${USER}/etc/profile.d/hm-session-vars.sh ] && . /etc/profiles/per-user/${USER}/etc/profile.d/hm-session-vars.sh

# ksh/bash specific
unset HISTFILE
unset TMOUT
unset TIMEOUT
export IGNOREEOF=1

export NETHACKOPTIONS='decgraphics,gender:male,dogname:Spot,pickup_types:$,race:Elf,role:Valkyrie,color'

export BLOCKSIZE=1K

export LANG=C.UTF-8
export LC_CTYPE=en_US.UTF-8
export PAPERSIZE=a4

export VISUAL=nvim
export EDITOR=${VISUAL}
# plain less: the options live in $LESS (bashrc/zshrc)
export PAGER=less

# Don’t clear the screen after quitting a manual page
export MANPAGER="less -X";

[ -d ${HOME}/.tmp ] && export TMPDIR="${HOME}/.tmp"
[ -d ${HOME}/.log ] && export LOGDIR="${HOME}/.log/"

export ICEAUTHORITY=$TMPDIR/.ICEauthority
export XKBOPTIONS='compose:ralt'

case $OS in
debian)
  export DEBEMAIL='michel@oosterhof.net'
  export DEBFULLNAME='Michel Oosterhof'
;;
darwin)
  export HOMEBREW_NO_INSECURE_REDIRECT=1
  export LSCOLORS=gxfxbEaEBxxEhEhBaDaCaD
  export BASH_SILENCE_DEPRECATION_WARNING=1
  # Secure Enclave provider for sk-type SSH keys (ssh-add/ssh-keygen)
  export SSH_SK_PROVIDER=/usr/lib/ssh-keychain.dylib
  # Homebrew environment, equivalent to `brew shellenv` for /opt/homebrew
  # but inlined: the eval forks brew (bash) plus path_helper on every
  # shell for output that is static for a fixed prefix.
  if [ -x /opt/homebrew/bin/brew ]; then
    export HOMEBREW_PREFIX=/opt/homebrew
    export HOMEBREW_CELLAR=/opt/homebrew/Cellar
    export HOMEBREW_REPOSITORY=/opt/homebrew
    export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:${PATH}"
    export FPATH="/opt/homebrew/share/zsh/site-functions:${FPATH}"
    [ -z "${MANPATH-}" ] || export MANPATH=":${MANPATH#:}"
    export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
  fi
;;
esac

NIXPROFILES=( /nix/var/nix/profiles/default/etc/profile.d/nix.sh
              ${HOME}/.nix-profile/etc/profile.d/nix.sh
              /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh )

for profile in $NIXPROFILES; do
    if [ -e $profile ]; then 
        source $profile
    fi
done

# Set marker so this is not run twice
export MICHEL=1

# eof
